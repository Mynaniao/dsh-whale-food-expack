{
  "name": "dsh-whale-food-expack",
  "version": "1.0.0",
  "description": "大肥鱼附加插件：给插件市场的 dsh-whale-widget 叠加喂白米饭（满碗→喂掉→空碗→点击盛满）、饱食度系统（干活掉得快、饿了会喊）、以及干活时敲键盘露手与当前工具提示。不修改本体，可随上游更新。",
  "type": "module",
  "license": "MIT",
  "author": "Mynaniao",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "whale",
    "widget",
    "rice",
    "satiety",
    "pet"
  ],
  "homepage": "https://github.com/Mynaniao/dsh-whale-food-expack#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mynaniao/dsh-whale-food-expack.git"
  },
  "bugs": {
    "url": "https://github.com/Mynaniao/dsh-whale-food-expack/issues"
  },
  "main": "lib/index.js",
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "dsh-whale-widget": ">=0.3.0"
  },
  "peerDependenciesMeta": {
    "dsh-whale-widget": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/host.mjs && node test/satiety.mjs"
  }
}
